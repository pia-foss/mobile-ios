      "product-type": "application",
      "last-swift-migration": "9.0",
      "specialized-configurations": [
        { "name": "Debug", "file": { "anchor": "Resources", "relative-path": "Configurations/Production.xcconfig" } },
        { "name": "Release", "file": { "anchor": "Resources", "relative-path": "Configurations/Production.xcconfig" } },
        { "name": "Staging", "file": { "anchor": "Resources", "relative-path": "Configurations/Staging.xcconfig" } },
