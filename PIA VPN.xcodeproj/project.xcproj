    }, {
      "name": "PIA VPN-tvOS",
      "id": "E5C507762B0E144D00200A6A",
      "product": "Products/PIA VPN-tvOS.app",
      "product-type": "application",
      "specialized-configurations": [
        { "name": "Debug", "file": { "anchor": "Resources", "relative-path": "Configurations/Production.xcconfig" } },
        { "name": "Release", "file": { "anchor": "Resources", "relative-path": "Configurations/Production.xcconfig" } },
        { "name": "Staging", "file": { "anchor": "Resources", "relative-path": "Configurations/Staging.xcconfig" } },
      ],
      "dependencies": [
        "PlatformSDK-Tunnel-tvOS",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "script",
          "name": "Download Latest Regions List",
          "log-environment-variables": true,
          "shell": "/bin/bash",
          "script": [
            "# update max once an hour",
            "set -e",
            "",
            "REGIONS_FILE=\"${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}/Regions.json\"",
            "",
            "if [[ ! -r \"${REGIONS_FILE}\" || $(find \"${REGIONS_FILE}\" -mmin +60) ]]; then",
            "echo \"downloading regions list to ${REGIONS_FILE}\"",
            "curl -sfo \"/tmp/piatvos.tmp\" \"https://serverlist.piaservers.net/vpninfo/servers/v7\"",
            "",
            "if [ $? -ne 0 ]; then",
            "echo \"failed to fetch regions list from server\"",
            "exit 1",
            "fi",
            "",
            "head -n 1 \"/tmp/piatvos.tmp\" > \"${REGIONS_FILE}\"",
            "rm \"/tmp/piatvos.tmp\"",
            "fi",
            "",
          ],
        }, {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "package-product-members": [
        {
          "product-name": "PIAAssetsFlags",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "PIAAssetsTV",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "PIADashboard",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "PIADebugMenu",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "PIADedicatedIP",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "PIALibrary",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "PIALocalizations",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "PIASwiftUI",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "OpenSSL-Package",
          "product-name": "OpenSSL",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "OpenSSL-Package",
          "product-name": "OpenSSL",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ARCHS": "$(ARCHS_STANDARD)",
